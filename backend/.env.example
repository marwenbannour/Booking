NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://booking:booking_dev_only@localhost:5432/booking?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes-for-local-development
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=604800
PASSWORD_RESET_TTL_SECONDS=1800
EMAIL_CHANGE_TTL_SECONDS=3600
FRONTEND_URL=http://localhost:5173

# SMTP account email delivery. Local development uses Mailpit from docker-compose.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Booking <no-reply@booking.local>

# Web refresh-token cookie. Use SameSite=None only for cross-site deployments (requires Secure).
REFRESH_COOKIE_SAME_SITE=lax
REFRESH_COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://localhost:5500,http://localhost:8081

# Notifications dispatcher (outbox relay). Disable on API-only instances.
NOTIFICATIONS_DISPATCHER_ENABLED=true
NOTIFICATIONS_DISPATCH_INTERVAL_MS=2000
NOTIFICATIONS_DISPATCH_BATCH=50

# WhatsApp provider: "mock" (local, logs only) or "meta" (WhatsApp Cloud API).
WHATSAPP_PROVIDER=mock
# Required when WHATSAPP_PROVIDER=meta:
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Optional Meta Graph API overrides:
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_REQUEST_TIMEOUT_MS=10000

# Payment provider webhook (HMAC-SHA256 over the raw body, header x-signature).
PAYMENTS_WEBHOOK_SECRET=

# Subscription status maintenance (periodic TRIALING->EXPIRED/PAST_DUE).
SUBSCRIPTION_MAINTENANCE_ENABLED=true
SUBSCRIPTION_MAINTENANCE_INTERVAL_MS=60000

# Platform super-admins. Comma-separated emails to bootstrap /admin access
# (in addition to users flagged is_platform_admin in the database).
PLATFORM_ADMIN_EMAILS=
